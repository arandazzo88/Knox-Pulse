rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // communityEvents is now only a public-submission QUEUE, not the catalog.
    // The site no longer displays it; data/listings.json is the source of truth.
    // The public "Submit Event" form creates docs; the admin Community tab reads
    // and clears them; approved events are committed into data/listings.json.
    // update is closed (submissions aren't edited in place). read/create/delete
    // stay open only because there is no Firebase Auth yet to scope them to the
    // admin — that (or moving submissions to a serverless endpoint) is the
    // remaining hardening step now that this is no longer a display source.
    match /communityEvents/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // Admin-managed custom listings
    match /listings/{docId} {
      allow read: if true;
      allow write: if false;  // admin writes go through server functions
    }

    // Reviews — anyone can read and create, no editing/deleting
    match /reviews/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Photos — anyone can read and create
    match /photos/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Edit requests — anyone can read and create
    match /editRequests/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Everything else — deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
